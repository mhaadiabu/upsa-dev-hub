{
  "name": "upsa-dev-hub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint:typecheck": "TSRS_FAST=1 oxlint --type-aware --type-check",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev:bare",
    "deploy": "vp run --filter @upsa-dev-hub/infra deploy",
    "destroy": "vp run --filter @upsa-dev-hub/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "^26.6.6",
    "@upsa-dev-hub/config": "workspace:*",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "rolldown": "1.3.3",
    "tsrs": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "1.7.0"
  },
  "packageManager": "pnpm@12.16.1"
}
